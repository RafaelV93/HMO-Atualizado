{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "lms": {
      "root": "easelms-main/apps/lms",
      "framework": "nextjs"
    },
    "website": {
      "root": "easelms-main/apps/website",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/app/(.*)",
      "destination": {
        "service": "lms"
      }
    },
    {
      "source": "/((?!api/).*)",
      "destination": {
        "service": "website"
      }
    }
  ]
}
